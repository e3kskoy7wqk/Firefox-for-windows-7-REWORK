+
+bool nsFilePicker::FilePickerWrapper(OPENFILENAMEW* ofn, PickerType aType) {
+  if (!ofn) return false;
+  AutoWidgetPickerState awps(mParentWidget);
+  mDlgWnd = nullptr;
+  bool result = GetFileNameWrapper(ofn, aType);
+  mDlgWnd = nullptr;
+  return result;
+}
