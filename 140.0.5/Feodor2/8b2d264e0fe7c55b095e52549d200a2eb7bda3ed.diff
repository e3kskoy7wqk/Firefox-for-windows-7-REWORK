+/* static */
+bool nsFilePicker::GetFileNameWrapper(OPENFILENAMEW* ofn, PickerType aType) {
+  MOZ_SEH_TRY {
+    if (aType == PICKER_TYPE_OPEN)
+      return ::GetOpenFileNameW(ofn);
+    else if (aType == PICKER_TYPE_SAVE)
+      return ::GetSaveFileNameW(ofn);
