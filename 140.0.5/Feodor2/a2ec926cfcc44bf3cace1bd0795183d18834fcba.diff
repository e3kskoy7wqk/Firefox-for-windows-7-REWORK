+static HMODULE load_dxgi_module() {
+    TCHAR systemPath[MAX_PATH] = TEXT("");
+    GetSystemDirectory(systemPath, MAX_PATH);
+    StringCchCat(systemPath, MAX_PATH, TEXT("\\dxgi.dll"));
+
+    return LoadLibrary(systemPath);
+}
