+
+.model flat
+
+EXTERN _LibInitOnceBeginInitialize@16 : PROC
+EXTERN _LibInitOnceComplete@12 : PROC
+
+.code
+
+PUBLIC _InitOnceBeginInitialize@16
+_InitOnceBeginInitialize@16 PROC
+    jmp _LibInitOnceBeginInitialize@16
