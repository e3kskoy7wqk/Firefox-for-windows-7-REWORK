+__imp__InitOnceBeginInitialize@16 dd _LibInitOnceBeginInitialize@16
+
+PUBLIC __imp__InitOnceComplete@12
+__imp__InitOnceComplete@12 dd _LibInitOnceComplete@12
+
+CONST ENDS
+
+END
