+pub unsafe extern "system" fn CoIncrementMTAUsage(pcookie: *mut CO_MTA_USAGE_COOKIE) -> HRESULT {
+    unsafe {
+        if !pcookie.is_null() {
+            *pcookie = core::ptr::null_mut();
+        }
+        let library = LoadLibraryExA(b"ole32.dll\0".as_ptr(), core::ptr::null_mut(), 0);
+        if library.is_null() {
+            return 0x80004001u32 as HRESULT;
+        }
+        let result = match GetProcAddress(library, b"CoIncrementMTAUsage\0".as_ptr()) {
+            Some(function) => {
+                let function: unsafe extern "system" fn(*mut CO_MTA_USAGE_COOKIE) -> HRESULT =
+                    core::mem::transmute(function);
+                function(pcookie)
+            }
+            None => 0x80004001u32 as HRESULT,
+        };
+        FreeLibrary(library);
+        result
+    }
+}
