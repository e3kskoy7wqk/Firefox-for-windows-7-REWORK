 enum class DecoderType {
   AV1,
+  Opus,
+  Vorbis,
   VPX,
+  Wave,
 };
 
 static bool IsAvailableInDefault(DecoderType type) {
   switch (type) {
     case DecoderType::AV1:
       return StaticPrefs::media_av1_enabled();
+    case DecoderType::Opus:
+    case DecoderType::Vorbis:
     case DecoderType::VPX:
