diff --git a/dom/media/platforms/PDMFactory.cpp b/dom/media/platforms/PDMFactory.cpp
index f73ed41..b454c64 100644
--- a/dom/media/platforms/PDMFactory.cpp
+++ b/dom/media/platforms/PDMFactory.cpp
@@ -534,7 +534,16 @@ void PDMFactory::CreateGpuPDMs() {
   if (StaticPrefs::media_ffvpx_hw_enabled()) {
     StartupPDM(FFVPXRuntimeLinker::CreateDecoder());
   }
-  if (StaticPrefs::media_wmf_enabled() && !IsWin7AndPre2000Compatible()) {
+  if (StaticPrefs::media_wmf_enabled() && IsVistaOrLater() && !IsWin7AndPre2000Compatible()) {
+    // *Only* use WMF on Vista and later, as if Firefox is run in Windows 95
+    // compatibility mode on Windows 7 (it does happen!) we may crash trying
+    // to startup WMF. So we need to detect the OS version here, as in
+    // compatibility mode IsVistaOrLater() and friends behave as if we're on
+    // the emulated version of Windows. See bug 1279171.
+    // Additionally, we don't want to start the RemoteDecoderModule if we
+    // expect it's not going to work (i.e. on Windows older than Vista).
+    // IsWin7AndPre2000Compatible() uses GetVersionEx as the user specified OS version can
+    // be reflected when compatibility mode is in effect.
     StartupPDM(WMFDecoderModule::Create());
   }
 #elif defined(MOZ_WIDGET_ANDROID)
@@ -668,7 +677,9 @@ void PDMFactory::CreateContentPDMs() {
         RemoteDecoderModule::Create(RemoteMediaIn::UtilityProcess_AppleMedia));
 #endif
 #ifdef XP_WIN
-    StartupPDM(RemoteDecoderModule::Create(RemoteMediaIn::UtilityProcess_WMF));
+    if (IsVistaOrLater() && !IsWin7AndPre2000Compatible()) {
+      StartupPDM(RemoteDecoderModule::Create(RemoteMediaIn::UtilityProcess_WMF));
+    }
 #endif
     // WMF and AppleMedia should be created before Generic because the order
     // affects what decoder module would be chose first.
diff --git a/dom/media/platforms/wmf/WMFUtils.cpp b/dom/media/platforms/wmf/WMFUtils.cpp
index 5039464..7c7caff 100644
--- a/dom/media/platforms/wmf/WMFUtils.cpp
+++ b/dom/media/platforms/wmf/WMFUtils.cpp
@@ -490,13 +490,13 @@ LoadDLLs() {
 
 HRESULT
 MediaFoundationInitializer::MFStartup() {
-  if (IsWin7AndPre2000Compatible()) {
-    /*
-     * Specific exclude the usage of WMF on Win 7 with compatibility mode
-     * prior to Win 2000 as we may crash while trying to startup WMF.
-     * Using GetVersionEx API which takes compatibility mode into account.
-     * See Bug 1279171.
-     */
+  if (!IsVistaOrLater() || IsWin7AndPre2000Compatible()) {
+    // *Only* use WMF on Vista and later, as if Firefox is run in Windows 95
+    // compatibility mode on Windows 7 (it does happen!) we may crash trying
+    // to startup WMF. So we need to detect the OS version here, as in
+    // compatibility mode IsVistaOrLater() and friends behave as if we're on
+    // the emulated version of Windows. See bug 1279171.
+    // Using GetVersionEx API which takes compatibility mode into account.
     return E_FAIL;
   }
 
@@ -505,6 +505,7 @@ MediaFoundationInitializer::MFStartup() {
     return hr;
   }
 
+  const int MF_VISTA_VERSION = (0x0001 << 16 | MF_API_VERSION);
   const int MF_WIN7_VERSION = (0x0002 << 16 | MF_API_VERSION);
 
   // decltype is unusable for functions having default parameters
@@ -512,8 +513,13 @@ MediaFoundationInitializer::MFStartup() {
   ENSURE_FUNCTION_PTR_(MFStartup, Mfplat.dll)
 
   hr = E_FAIL;
-  mozilla::mscom::EnsureMTA(
+  if (!IsWin7OrLater()) {
+    mozilla::mscom::EnsureMTA(
+      [&]() -> void { hr = MFStartupPtr(MF_VISTA_VERSION , MFSTARTUP_FULL); });
+    } else {
+    mozilla::mscom::EnsureMTA(
       [&]() -> void { hr = MFStartupPtr(MF_WIN7_VERSION, MFSTARTUP_FULL); });
+    }
   return hr;
 }
 
