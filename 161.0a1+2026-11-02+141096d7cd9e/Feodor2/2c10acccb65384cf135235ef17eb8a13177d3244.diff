+bool nsNSSComponent::ShouldEnableEnterpriseRootsForFamilySafety(
+    uint32_t familySafetyMode) {
+#ifdef XP_WIN
+  if (!(IsWin8Point1OrLater() && !IsWin10OrLater())) {
