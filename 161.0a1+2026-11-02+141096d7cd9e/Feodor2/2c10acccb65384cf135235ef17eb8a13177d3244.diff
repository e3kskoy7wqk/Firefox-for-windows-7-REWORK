+    return false;
+  }
+  bool familySafetyEnabled;
+  nsresult rv = AccountHasFamilySafetyEnabled(familySafetyEnabled);
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+  return familySafetyEnabled;
+#else
+  return false;
+#endif  // XP_WIN
+}
