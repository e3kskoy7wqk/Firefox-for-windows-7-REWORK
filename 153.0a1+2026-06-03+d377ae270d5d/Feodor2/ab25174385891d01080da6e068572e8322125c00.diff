+void nsLookAndFeel::UpdateNativeThemeInfo() {
+  if (!nsLookAndFeel::IsAppThemed()) {
+    sThemeId = WindowsTheme::Classic;
+    return;
+  }
+
+  WCHAR themeFileName[MAX_PATH + 1];
+  WCHAR themeColor[MAX_PATH + 1];
