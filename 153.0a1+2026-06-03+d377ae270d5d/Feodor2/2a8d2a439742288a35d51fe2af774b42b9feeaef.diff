diff --git a/browser/themes/windows/browser-aero.css b/browser/themes/windows/browser-aero.css
new file mode 100644
index 0000000..d796894
--- /dev/null
+++ b/browser/themes/windows/browser-aero.css
@@ -0,0 +1,42 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+@media (-moz-windows-default-theme) {
+  @media (-moz-windows-accent-color-in-titlebar) {
+    :root[sizemode=normal][customtitlebar] #navigator-toolbox {
+      border-top: .5px solid ActiveBorder;
+    }
+  }
+
+  :root[sizemode=normal][customtitlebar]:-moz-window-inactive #navigator-toolbox {
+    border-top-color: InactiveBorder;
+  }
+
+  :root[customtitlebar] .tab-label:-moz-window-inactive {
+    /* Calculated to match the opacity change of Windows Explorer
+       titlebar text change for inactive windows. */
+    opacity: .6;
+  }
+
+  :root[customtitlebar] .tab-secondary-label:-moz-window-inactive {
+    opacity: .6;
+  }
+}
+
+/* See bug 1715990 about why we do this ourselves on HCM */
+@media (prefers-contrast) {
+  :root[customtitlebar]:not([lwtheme]) {
+    background-color: ActiveCaption;
+    color: CaptionText;
+  }
+
+  :root[customtitlebar]:not([lwtheme]):-moz-window-inactive {
+    background-color: InactiveCaption;
+    color: InactiveCaptionText;
+  }
+
+  :root:not([lwtheme]) #appcontent {
+    background-color: -moz-dialog;
+  }
+}
