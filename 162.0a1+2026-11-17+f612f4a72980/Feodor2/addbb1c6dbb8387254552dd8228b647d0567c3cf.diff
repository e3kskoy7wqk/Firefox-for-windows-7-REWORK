+#  if defined(_M_AMD64)
+[[clang::optnone]] MOZ_NEVER_INLINE bool UnoptimizedCriticalSectionLookups(
+    void* aAddress, RUNTIME_FUNCTION* aExpected) {
+  DWORD64 imageBase;
+  ::RtlLookupFunctionEntry(reinterpret_cast<DWORD64>(UnoptimizedLookup),
+                           &imageBase, nullptr);
+  ::RtlLookupFunctionEntry(0, &imageBase, nullptr);
+  return ::RtlLookupFunctionEntry(reinterpret_cast<DWORD64>(aAddress),
+                                  &imageBase, nullptr) == aExpected &&
+         imageBase == reinterpret_cast<DWORD64>(aAddress);
+}
+#  endif  // _M_AMD64
+
+MFBT_API
+bool CollectStackWalkCriticalSections(Array<void*, 2>& aStackWalkLocks) {
+#  if defined(_M_AMD64)
+  auto* ntdll = ::GetModuleHandleW(L"ntdll.dll");
+  auto enter = ::GetProcAddress(ntdll, "RtlEnterCriticalSection");
+  auto leave = ::GetProcAddress(ntdll, "RtlLeaveCriticalSection");
+  nt::PEHeaders ntdllImage(ntdll);
+  if (!enter || !leave || !ntdllImage) {
+    return false;
+  }
+  auto dataSection = ntdllImage.GetDataSectionInfo();
+  if (dataSection.isNothing()) {
+    return false;
+  }
+  const uintptr_t dataBegin = reinterpret_cast<uintptr_t>(dataSection->data());
+  const uintptr_t dataEnd = dataBegin + dataSection->size();
+
+  void* probe =
+      ::VirtualAlloc(nullptr, 4096, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+  if (!probe) {
+    return false;
+  }
+  auto freeProbe = MakeScopeExit([&] { ::VirtualFree(probe, 0, MEM_RELEASE); });
+  // Force a dynamic-table lookup even when no JIT tables exist yet.
+  static_cast<uint8_t*>(probe)[16] =
+      1;  // UNWIND_INFO version 1, no unwind codes.
+  RUNTIME_FUNCTION functionEntry{};
+  functionEntry.EndAddress = 16;
+  functionEntry.UnwindData = 16;
+  {
+    AutoSuppressStackWalking suppress;
+    if (!::RtlAddFunctionTable(&functionEntry, 1,
+                               reinterpret_cast<DWORD64>(probe))) {
+      return false;
+    }
+  }
+  auto removeFunctionTable = MakeScopeExit([&] {
+    AutoSuppressStackWalking suppress;
+    ::RtlDeleteFunctionTable(&functionEntry);
+  });
+
+  struct LockCollectionData {
+    Array<void*, 2> mLocks{};
+    Array<bool, 2> mEntered{};
+    Array<bool, 2> mLeft{};
+    size_t mCount = 0;
+    bool mInvalidLock = false;
+    bool mOverflow = false;
+    uintptr_t mDataBegin;
+    uintptr_t mDataEnd;
+    DWORD64 mEnter;
+    DWORD64 mLeave;
+  } data{};
+  data.mDataBegin = dataBegin;
+  data.mDataEnd = dataEnd;
+  data.mEnter = reinterpret_cast<DWORD64>(enter);
+  data.mLeave = reinterpret_cast<DWORD64>(leave);
+
+  bool foundDynamicTable = false;
+  WindowsDiagnosticsError error = CollectSingleStepData(
+      [&] {
+        foundDynamicTable =
+            UnoptimizedCriticalSectionLookups(probe, &functionEntry);
+      },
+      [](void* aState, CONTEXT* aContext) {
+        auto& data = *reinterpret_cast<LockCollectionData*>(aState);
+        if (aContext->Rip != data.mEnter && aContext->Rip != data.mLeave) {
+          return true;
+        }
+        auto address = static_cast<uintptr_t>(aContext->Rcx);
+        if (address < data.mDataBegin || address > data.mDataEnd ||
+            data.mDataEnd - address < sizeof(CRITICAL_SECTION) ||
+            address % alignof(CRITICAL_SECTION) != 0) {
+          data.mInvalidLock = true;
+          return true;
+        }
+        size_t index = 0;
+        for (; index < data.mCount; ++index) {
+          if (data.mLocks[index] == reinterpret_cast<void*>(address)) {
+            break;
+          }
+        }
+        if (index == data.mCount) {
+          if (data.mCount == data.mLocks.Length) {
+            data.mOverflow = true;
+            return true;
+          }
+          data.mLocks[index] = reinterpret_cast<void*>(address);
+          ++data.mCount;
+        }
+        if (index < data.mLocks.Length) {
+          if (aContext->Rip == data.mEnter) {
+            data.mEntered[index] = true;
+          } else {
+            data.mLeft[index] = true;
+          }
+        }
+        return true;
+      },
+      &data);
+
+  if (error != WindowsDiagnosticsError::None || !foundDynamicTable ||
+      data.mCount == 0 || data.mInvalidLock || data.mOverflow) {
+    return false;
+  }
+  for (size_t i = 0; i < data.mCount; ++i) {
+    if (!data.mEntered[i] || !data.mLeft[i]) {
+      return false;
+    }
+  }
+  aStackWalkLocks = data.mLocks;
+  return true;
+#  else
+  return false;
+#  endif
+}
+
+MFBT_API
+bool ValidateStackWalkCriticalSections(const Array<void*, 2>& aStackWalkLocks) {
+  if (!aStackWalkLocks[0]) {
+    return false;
+  }
+  nt::PEHeaders ntdllImage(::GetModuleHandleW(L"ntdll.dll"));
+  if (!ntdllImage) {
+    return false;
+  }
+  auto dataSection = ntdllImage.GetDataSectionInfo();
+  if (dataSection.isNothing()) {
+    return false;
+  }
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(dataSection->data());
+  const uintptr_t end = begin + dataSection->size();
+  for (void* lock : aStackWalkLocks) {
+    if (!lock) {
+      continue;
+    }
+    uintptr_t address = reinterpret_cast<uintptr_t>(lock);
+    if (address < begin || address > end ||
+        end - address < sizeof(CRITICAL_SECTION) ||
+        address % alignof(CRITICAL_SECTION) != 0) {
+      return false;
+    }
+  }
+  return true;
+}
